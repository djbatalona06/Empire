{
  "name": "dealerdoor-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.152.0"
  }
}
